# 密钥与配置文件（含明文密钥，切勿提交）
launcher_config.json
deploy_config.txt

# 运行时数据
data/users.json
data/sessions.json
data/submissions.json

# 日志与进程记录
server_*.log
*.pid

# Python 缓存
__pycache__/
*.py[cod]

# 便携运行环境（Docker 镜像自带运行环境, 此目录仅本地开发调试用, 不入库）
runtime/

# 工具自动生成的变更追踪文件（before/diff/rollback 快照，不提交）
.ui-update/

# 本地 HTTPS 证书（自签名，按部署生成）
certs/

# 系统文件
Thumbs.db
.DS_Store

# IDE / 编辑器
.idea/
.vscode/
